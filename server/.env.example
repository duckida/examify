# AI Provider Configuration
# ========================
# The "Free endpoint" option in the app uses this server-side key.
# The "Hack Club AI" option uses a user-provided API key from the client.

# Required for the "Free endpoint" option:
# BYLD_API_KEY=your_byld_api_key

# Optional: override the default endpoint and model used by the "Free endpoint"
# BYLD_BASE_URL=https://byld.cc/v1
# BYLD_MODEL=deepseek-v4.1
# LLM_MODEL=deepseek-v4.1

# Optional: thinking effort for the "Free endpoint"
# (xhigh | high | medium | low | minimal | none), defaults to low
# BYLD_REASONING_EFFORT=low
